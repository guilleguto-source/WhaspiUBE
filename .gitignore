# Dependencias
node_modules/

# Variables de entorno y credenciales (AgentShield)
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Base de datos y sesiones locales
*.db
*.sqlite
wa-bot/data/sessions.db*
sessions.db

# WhatsApp Web Auth y Cache
.wwebjs_auth/
.wwebjs_cache/
wa-bot/.wwebjs_auth/
wa-bot/.wwebjs_cache/

# Archivos temporales y multimedia procesada
wa-bot/data/tmp/
tmp/
*.log

# Python / OCR
__pycache__/
*.py[cod]
*$py.class

# Modelos pesados y audio
wa-bot/models/
*.onnx
wa-bot/data/audio/
wa-bot/data/memoria/*.json
!wa-bot/data/memoria/plantilla-ficha.json
wa-bot/certs/

# Backups y auditorías locales
wa-bot_backup_v2/
wa-bot/data/auditoria/
wa-bot/data/conversaciones_simuladas.jsonl
wa-bot/data/feed-token.txt
wa-bot/.agents/
wa-bot/qr.png
