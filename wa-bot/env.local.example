# ================================================================
# WhaspiUBE · .env para operación LOCAL (PC servidora)
# Copiar como ".env" dentro de wa-bot/ y completar las claves.
# ================================================================

# Modo local: Ollama primero, nube SOLO como respaldo y para Whisper
AI_MODE=local

# Servidor y base de datos
PORT=3000
DB_PATH=data/sessions.db

# Gateway de mensajería (los 3 contenedores Docker)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=cambia_esta_clave_por_una_fuerte
EVOLUTION_INSTANCE=ube-bot
POSTGRES_PASSWORD=cambia_tambien_esta_password

# LLM local (proceso nativo, GPU directa, sin puentes de red)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=ube-asistente

# Respaldo de nube: SOLO para notas de voz (Whisper).
# Dejar GEMINI_API_KEY vacío para operación 100% local.
GROQ_API_KEY=gsk_tu_clave_aqui
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Seguridad (OBLIGATORIO en producción)
# Generar con:  openssl rand -hex 24
WEBHOOK_TOKEN=
WEBHOOK_SECRET=

# Aviso al asesor humano (parche A.5 del PDF): número con código de país
ASESOR_ALERTA_PHONE=5939XXXXXXXX

# Protocolo anti-visto: false mientras pruebas, true en producción
TOQUES_ACTIVOS=false

# Material académico y trípticos PDF
UBE_MATERIAL_DIR=C:\Users\Guill\Documents\UBE_Material
UBE_MATERIAL_HOST_PATH=./material

# Enlaces oficiales del siguiente paso (post-cierre)
LINK_INSCRIPCION_GRADO=https://admisiones.ube.edu.ec/inscripcion
LINK_CHECKLIST_VALIDACION=https://admisiones.ube.edu.ec/checklist-validacion
LINK_RESERVA_MAESTRIA=https://admisiones.ube.edu.ec/reserva-maestria

# Intérprete Python (para OCR con RapidOCR)
PYTHON_CMD=python
