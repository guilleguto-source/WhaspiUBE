# ===================== WhaspiUBE v5.2 · Diana =====================
# --- WhatsApp (Evolution API) ---
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=tu_apikey_evolution
EVOLUTION_INSTANCE=ube-bot
EVOLUTION_TIMEOUT_MS=20000
WEBHOOK_TOKEN=un_token_secreto_para_el_webhook

# --- IA (Groq y Gemini en alternancia 50/50 o failover instantáneo) ---
GROQ_API_KEY=tu_api_key_groq
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=tu_api_key_gemini
GEMINI_MODEL=gemini-2.5-flash
AI_STRATEGY=inteligente # 'inteligente' (Groq para turnos rápidos, Gemini para contextos largos y 429), 'alternar' o 'failover'
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen2.5:3b
AI_MODE=hybrid
HUMAN_DELAY_MS=6000

# --- Servidor ---
PORT=3000
# HTTPS_PORT=3443   # si existen certs/server.key + server.crt

# --- PIN Gate del panel (v5.2) ---
# Bloquea el panel web y TODA la /api. El webhook de Evolution queda abierto.
PANEL_PIN=052020

# --- Alertas humanas (v5.2 multi-destino) ---
# Leads calientes (ficha completa / handoff) y CITAS AGENDADAS → asesores + grupo
ASESOR_ALERTA_PHONE=593960946956,593998600136
# Grupo de WhatsApp de la operación (el BOT debe ser miembro del grupo):
# opción A - por nombre (se resuelve solo al arrancar):
ASESOR_GRUPO_NOMBRE=UBE - Better Together
# opción B - JID directo (más rápido; lo ves con listarGrupos o en Evolution):
# ASESOR_GRUPO_JID=120363xxxxxxxxxx@g.us
# Reporte de la matriz (días 1 y 16) y ERRORES del sistema → SOLO al grupo.
# Respaldo si el grupo no está disponible:
ADMIN_WHATSAPP=593960946956

# --- Matriz de valores (Excel oficial SharePoint, guest link) ---
CATALOGO_URL=https://istb-my.sharepoint.com/:x:/g/personal/njsuarezv_ube_edu_ec/IQCkeSBymyrhS7l_nZ1HlOfSAcEGWfmfKq2NuKATC6JwBI0

# --- Trípticos (PDFs) ---
# UBE_MATERIAL_DIR=/ruta/a/UBE_Material   # o copiar los PDFs a ./material

# --- Citas y calendario (v5.2) ---
# Duración del bloque que se crea en Google Calendar / feed .ics
CITA_DURACION_MIN=30
# Zona horaria (Ecuador)
APP_UTC_OFFSET=-5
# El token del feed .ics se genera solo en data/feed-token.txt (no se configura)

# --- Anti-visto ---
TOQUES_ACTIVOS=true

# --- Campaña de egresados (MODOS SEGUROS POR DEFECTO) ---
CAMPANA_ACTIVOS=false
CAMPANA_DRY_RUN=true
CAMPANA_FASE1_MAX=6
CAMPANA_FASE2_MAX=9
CAMPANA_HORA_INICIO1=08:45
CAMPANA_HORA_FIN1=11:50
CAMPANA_HORA_INICIO2=14:35
CAMPANA_HORA_FIN2=17:25
CAMPANA_INTER_MIN_MS=3000000
CAMPANA_INTER_MAX_MS=6600000
CAMPANA_TOQUE2_HORAS=72
CAMPANA_CIERRE_DIAS=7

