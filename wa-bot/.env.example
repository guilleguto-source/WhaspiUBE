# ================================================================
# WhaspiUBE · Variables de entorno · v2 (embudo en 4 turnos)
# ================================================================

AI_MODE=hybrid

# Servidor y Base de Datos
PORT=3000
DB_PATH=data/sessions.db

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=tu_clave_secreta_aqui
EVOLUTION_INSTANCE=ube-bot
POSTGRES_PASSWORD=tu_password_seguro_postgres

# Material Académico y Trípticos PDF
UBE_MATERIAL_DIR=C:\Users\Guill\Documents\UBE_Material
UBE_MATERIAL_HOST_PATH=./material

# Configuración Local (Ollama - diana-ube Qwen3 4B Non-Thinking)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=diana-ube

# Motor de Voz Humana (Edge-TTS Andrea Ecuatoriana con fallback a Kokoro local)
TTS_ENGINE=edge
EDGE_VOICE=es-EC-AndreaNeural

# Proveedores de Nube (opcionales, en cascada: Groq → Gemini → Ollama)
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Seguridad del webhook: si se define, rechaza peticiones sin token
WEBHOOK_TOKEN=
WEBHOOK_SECRET=

# Protocolo anti-visto (3 toques: 24h / 72h / 5-7 días + recordatorio 48h)
# Pon en false durante pruebas para no escribir a números reales
TOQUES_ACTIVOS=false

# Enlaces oficiales del siguiente paso (T4 / post-cierre)
LINK_INSCRIPCION_GRADO=https://admisiones.ube.edu.ec/inscripcion
LINK_CHECKLIST_VALIDACION=https://admisiones.ube.edu.ec/checklist-validacion
LINK_RESERVA_MAESTRIA=https://admisiones.ube.edu.ec/reserva-maestria

# Intérprete Python (para OCR)
PYTHON_CMD=python
